pipeline {
    agent {
        docker {
            image 'maven:3.9.16-eclipse-temurin-21'
        }
    }
    environment {
        MAVEN_OPTS = "-Dmaven.repo.local=${WORKSPACE}/.m2/repository"
    }
    stages {
        stage('Artifactory') {
            steps {
                sh 'mvn --version'
            }
        }
    }
    post {
        cleanup {
            cleanWs()
        }
    }
}